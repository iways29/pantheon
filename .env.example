# Pantheon — environment template. Copy to .env and fill in.
# Never commit .env. Secrets are server-side only; only NEXT_PUBLIC_* values
# may reach the browser.

# ---------------------------------------------------------------------------
# Supabase (owner creates the project by hand; see docs/BUILD_PLAN.md)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Anon / publishable key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Token verification on the API. Set the shared secret OR leave it blank to
# verify asymmetrically against the project's JWKS endpoint (derived from
# SUPABASE_URL unless SUPABASE_JWKS_URL is set). Confirm which signing scheme
# your project uses in the Supabase dashboard.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Phase 1 has exactly one operator. The auth.users UUID of the owner account;
# any other authenticated subject is rejected with 403.
OWNER_USER_ID=

# Service-role key. Server-side only — never expose to the browser.
# Not used at Step 0; added here so it is never invented ad hoc later.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development. `supabase start` serves on 54322; the plain-Postgres
# fallback in scripts/local_db.sh uses the server's own port, usually 5432.
# In production (Vercel) this must be Supabase's TRANSACTION pooler, port 6543:
# Vercel is IPv4-only and the direct connection is IPv6-only. The app and the
# LangGraph checkpointer are both built for it (ADR 005).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Scheduled runs (ADR 008)
# ---------------------------------------------------------------------------
# Shared secret the database's scheduler sends when it asks the API to advance
# a run. Generate a long random value, set it here AND in the Vercel project
# (server-side only), and store the same value in Supabase Vault as
# `pantheon_trigger_secret` (SQL editor: select vault.create_secret('<value>',
# 'pantheon_trigger_secret');). Leave it unset locally: with no secret the
# endpoint refuses every request.
TRIGGER_SECRET=

# Supabase transaction pooler connection string (Dashboard > Connect >
# Transaction pooler, port 6543), used only by `scripts/pooler_probe.py` to
# check the pooler before production relies on it. Contains the database
# password: server-side only, never committed.
SUPABASE_POOLER_URL=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Optional. On Vercel this is derived from VERCEL_ENV, so production and
# preview label themselves with no variable set. Set it only to override, or
# when running somewhere that is not Vercel.
# ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Path prefix when the API is mounted behind a rewrite. Empty when it serves
# its own domain root.
API_ROOT_PATH=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Model gateway (OpenRouter). The only path to models.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Which model each tier resolves to, as JSON. Agents choose a tier, never a
# model, so repointing a tier here retiers every agent on it without touching
# any agent row or any code.
#
# Slugs come from OpenRouter's model list -- fill these in from there rather
# than copying them from anywhere else, since the catalogue changes as models
# come and go. A tier left unset refuses loudly instead of silently falling
# back to something expensive.
#
# The default only. A row in model_tier_assignments overrides a tier for the
# org or for one department, and takes effect on the next call with no
# redeploy: `cd api && uv run python -m scripts.set_tier_model --help`. Every
# tier must still be set here, so a missing one fails on startup. See ADR 003.
#
# Pin explicit versioned slugs. OpenRouter's `~vendor/family-latest` aliases
# repoint themselves, which would change cost and behaviour with no signal.
MODEL_TIERS={"cheap":"deepseek/deepseek-v4-flash-0731","standard":"openai/gpt-5.6-sol","frontier":"anthropic/claude-opus-5"}

# ---------------------------------------------------------------------------
# TypeSafe Jev, the judge (Step 5; ADR 009). Server-side only; in Vercel it is a
# sensitive variable on the pantheon-api project. Keys: console.typesafe.ai/keys.
# The model each gate uses is pinned in the database (judge_gates), not here.
# Check the key with: cd api && uv run python -m scripts.jev_smoke
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
# Optional; defaults to https://api.typesafe.ai
TYPESAFE_BASE_URL=

# Tracing (Step 3; ADR 004). Langfuse Cloud, free Hobby tier. Server-side only.
# The base URL is the project's region, e.g. https://cloud.langfuse.com (EU)
# or https://us.cloud.langfuse.com (US) -- pick the one the project lives in.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
